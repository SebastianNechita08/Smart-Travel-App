<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="II.Search_page"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:II"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    NavigationCacheMode="Required"
    mc:Ignorable="d">

    <Grid x:Name="MainRoot">

        <Grid x:Name="SlideshowContainer" Background="Black">
            <Image x:Name="BgImage1" Stretch="UniformToFill">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="SlideTransform1" X="0"/>
                </Image.RenderTransform>
            </Image>
            <Image x:Name="BgImage2" Stretch="UniformToFill">
                <Image.RenderTransform>
                    <TranslateTransform x:Name="SlideTransform2" X="3000"/>
                </Image.RenderTransform>
            </Image>
            <Border Background="#80000000"/>
        </Grid>

        <Button Content="🚪 Delogare" 
                Click="LogoutButton_Click" 
                HorizontalAlignment="Right" 
                VerticalAlignment="Top" 
                Margin="30" 
                Background="#33FFFFFF" 
                Foreground="White" 
                BorderThickness="1" 
                BorderBrush="White"
                CornerRadius="8"/>

        <GridView x:Name="ResultsGrid" 
                  Margin="40,200,40,0" 
                  SelectionMode="None" 
                  IsItemClickEnabled="True" 
                  ItemClick="ResultsGrid_ItemClick" 
                  Visibility="Collapsed" 
                  Opacity="0">
            <GridView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="10" Width="220" Background="#E61E1E1E" CornerRadius="12" Padding="0,0,0,15">
                        <Image Source="{Binding ImageUrl}" Height="160" Stretch="UniformToFill"/>
                        <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="White" Margin="15,10,15,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Description}" Margin="15,5,15,0" Foreground="LightGray" Opacity="0.8" FontSize="12" TextWrapping="Wrap" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                </DataTemplate>
            </GridView.ItemTemplate>
        </GridView>

        <StackPanel x:Name="SearchContainer" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="30">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="SearchTransform" Y="0"/>
            </StackPanel.RenderTransform>

            <StackPanel x:Name="WelcomeText" Spacing="5" HorizontalAlignment="Center">
                <TextBlock Text="BUN VENIT LA URMĂTOAREA TA AVENTURĂ" FontSize="14" FontWeight="SemiBold" Foreground="LightGray" HorizontalAlignment="Center" CharacterSpacing="100"/>
                <TextBlock Text="Smart Travel" FontSize="70" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
            </StackPanel>

            <Border Background="White" CornerRadius="30" Padding="10,5" HorizontalAlignment="Center" MinWidth="600" RequestedTheme="Light">
                <StackPanel Orientation="Horizontal" Spacing="10">

                    <AutoSuggestBox x:Name="SearchBox" 
                                    PlaceholderText="Unde vrei să călătorești? (ex: Paris)" 
                                    QueryIcon="Find" 
                                    Width="380" 
                                    BorderThickness="0" 
                                    Background="Transparent"
                                    Foreground="Black"
                                    VerticalAlignment="Center"
                                    QuerySubmitted="SearchBox_QuerySubmitted"/>

                    <Border Width="1" Background="#E0E0E0" Margin="0,5"/>

                    <ComboBox x:Name="CategoryFilter" SelectedIndex="0" Width="190" BorderThickness="0" Background="Transparent" Foreground="Black" VerticalAlignment="Center">
                        <ComboBoxItem Content="Atracții Turistice" Tag="tourist attraction"/>
                        <ComboBoxItem Content="Restaurante" Tag="restaurant"/>
                        <ComboBoxItem Content="Muzee" Tag="museum"/>
                        <ComboBoxItem Content="Monumente" Tag="monument"/>
                        <ComboBoxItem Content="Parcuri și Natură" Tag="park"/>
                        <ComboBoxItem Content="Cumpărături" Tag="shopping"/>
                    </ComboBox>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Page>