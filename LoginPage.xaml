<Page
    x:Class="II.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid x:Name="MainGrid">

        <Image Source="https://images.unsplash.com/photo-1527631746610-bca00a040d60?q=80&amp;w=1000" 
               Stretch="UniformToFill"/>
        <Border Background="#66000000"/>

        <StackPanel x:Name="BrandingPanel" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="100,0,0,0">
            <StackPanel.RenderTransform>
                <TranslateTransform x:Name="BrandingTransform" X="0"/>
            </StackPanel.RenderTransform>

            <TextBlock Text="Smart" FontSize="70" FontWeight="ExtraBold" Foreground="White" HorizontalAlignment="Center"/>
            <TextBlock Text="Travel App" FontSize="28" FontWeight="Light" Foreground="White" Margin="0,-10,0,0" HorizontalAlignment="Center"/>
            <Border Background="White" Height="2" Width="100" Margin="0,20,0,20" HorizontalAlignment="Center"/>
            <TextBlock Text="Descoperă următoarea ta aventură." FontSize="16" Foreground="#CCFFFFFF" HorizontalAlignment="Center"/>
        </StackPanel>

        <Grid x:Name="FormPanel" HorizontalAlignment="Right" Width="450" Background="#1E1E1E" Padding="60,0">
            <Grid.RenderTransform>
                <TranslateTransform x:Name="FormTransform" X="0"/>
            </Grid.RenderTransform>

            <!-- FORMULARUL DE AUTENTIFICARE -->
            <StackPanel x:Name="LoginForm" VerticalAlignment="Center" Spacing="20">
                <TextBlock Text="Bine ai revenit!" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Introduceți datele pentru a continua." FontSize="14" Foreground="Gray" Margin="0,0,0,10"/>

                <TextBox x:Name="UsernameBox" Header="Utilizator" CornerRadius="8"/>
                <PasswordBox x:Name="PasswordBox" Header="Parolă" CornerRadius="8"/>
                <TextBlock x:Name="StatusMessage" FontSize="12" TextAlignment="Center" TextWrapping="Wrap"/>

                <Button Content="Autentificare" Click="LoginButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="0,12" CornerRadius="8"/>

                <Button Content="Creare Cont Nou" 
                        Click="SwitchToRegister_Click" 
                        HorizontalAlignment="Stretch" 
                        Padding="0,12" 
                        CornerRadius="8"/>
            </StackPanel>

            <!-- FORMULARUL DE ÎNREGISTRARE -->
            <StackPanel x:Name="RegisterForm" VerticalAlignment="Center" Spacing="15" Visibility="Collapsed">
                <TextBlock Text="Creare Cont" FontSize="32" FontWeight="Bold" Foreground="White"/>
                <TextBlock Text="Alătură-te comunității noastre." FontSize="14" Foreground="Gray" Margin="0,0,0,10"/>

                <TextBox x:Name="RegEmailBox" Header="Email" CornerRadius="8" PlaceholderText="ex: nume@email.com"/>
                <TextBox x:Name="RegUserBox" Header="Utilizator" CornerRadius="8"/>
                <PasswordBox x:Name="RegPassBox" Header="Parolă" CornerRadius="8"/>
                <PasswordBox x:Name="RegPassConfirmBox" Header="Confirmă Parola" CornerRadius="8"/>

                <!-- AICI AM ADĂUGAT MESAJUL DE EROARE PENTRU ÎNREGISTRARE -->
                <TextBlock x:Name="RegStatusMessage" FontSize="12" TextAlignment="Center" TextWrapping="Wrap" Foreground="Red" />

                <Button Content="Creează Cont" Click="RegisterButton_Click" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="0,12" CornerRadius="8" Margin="0,10,0,0"/>

                <Button Content="Înapoi la Autentificare" 
                        Click="SwitchToLogin_Click" 
                        HorizontalAlignment="Stretch" 
                        Padding="0,12" 
                        CornerRadius="8"/>
            </StackPanel>
        </Grid>

    </Grid>
</Page>