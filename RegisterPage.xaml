<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="II.RegisterPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:II">

    <Grid>
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10" Width="320">

            <TextBlock Text="Creează un cont nou" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,10"/>

            <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="email@exemplu.com"/>
            <TextBox x:Name="UsernameBox" Header="Nume utilizator" PlaceholderText="Alege un username"/>
            <PasswordBox x:Name="PasswordBox" Header="Parola" PlaceholderText="Minim 8 caractere (a, A, 1, #)" PasswordChar="*"/>
            <PasswordBox x:Name="ConfirmPasswordBox" Header="Confirma parola" PlaceholderText="Repeta parola" PasswordChar="*"/>

            <Button Content="Inregistrare" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="RegisterSubmit_Click" Margin="0,15,0,0"/>
            <Button Content="Inapoi la Autentificare" HorizontalAlignment="Stretch" Click="BackToLogin_Click"/>

            <TextBlock x:Name="StatusMessage" Foreground="Red" HorizontalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>
    </Grid>
</Page>